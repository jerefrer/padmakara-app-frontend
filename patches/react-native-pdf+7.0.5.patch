+// Leaves room above the first page for a toolbar laid over the document: the
+// document starts below it and scrolls under it. Only the scroll view's inset
+// changes; the PDF view keeps its size, so its pages are not laid out again.
+// The inset counts from the top of the view, so the part iOS already adds for
+// the status bar is taken off.
+- (void)applyContentInsetTop
+{
+    UIScrollView *scrollView = [self findScrollView:_pdfView depth:0];
+    if (scrollView == nil) {
+        return;
+    }
+    CGFloat previousTop = scrollView.adjustedContentInset.top;
+    BOOL atTop = scrollView.contentOffset.y <= -previousTop + 0.5;
+    CGFloat systemTop = previousTop - scrollView.contentInset.top;
+    UIEdgeInsets inset = scrollView.contentInset;
+    inset.top = _horizontal ? 0 : MAX(0, _contentInsetTop - systemTop);
+    scrollView.contentInset = inset;
+    if (atTop) {
