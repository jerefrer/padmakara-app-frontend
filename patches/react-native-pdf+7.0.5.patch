+- (UIScrollView *)findScrollView:(UIView *)view depth:(int)depth {
+    if (view == nil || depth > 10) {
+        return nil;
+    }
+    if ([view isKindOfClass:[UIScrollView class]]) {
+        return (UIScrollView *)view;
+    }
+    for (UIView *subview in view.subviews) {
+        UIScrollView *found = [self findScrollView:subview depth:depth + 1];
+        if (found != nil) {
+            return found;
+        }
+    }
+    return nil;
