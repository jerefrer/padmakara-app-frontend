+// The safe area is often still zero when the document loads, hence the second
+// pass in safeAreaInsetsDidChange.
+- (void)applyContentInsetTop
+{
+    UIScrollView *scrollView = [self findScrollView:_pdfView depth:0];
+    if (scrollView == nil) {
+        return;
+    }
+    BOOL atTop = scrollView.contentOffset.y <= -scrollView.adjustedContentInset.top + 0.5;
+    CGFloat systemTop = scrollView.contentInsetAdjustmentBehavior == UIScrollViewContentInsetAdjustmentNever ? 0 : self.safeAreaInsets.top;
+    UIEdgeInsets inset = scrollView.contentInset;
