--- a/node_modules/expo-video/ios/NowPlayingManager.swift
+++ b/node_modules/expo-video/ios/NowPlayingManager.swift
@@ -42,6 +42,12 @@ class NowPlayingManager: VideoPlayerObserverDelegate {
   }
 
   func unregisterPlayer(_ player: VideoPlayer) {
+    // A player that never registered (or was already unregistered) owns nothing on the lock
+    // screen. Without this guard, releasing or hiding an idle video wiped the Now Playing
+    // card another module (expo-audio) had set.
+    guard players.allObjects.contains(where: { $0 === player }) else {
+      return
+    }
     players.remove(player)
     player.observer?.unregisterDelegate(delegate: self)
 
